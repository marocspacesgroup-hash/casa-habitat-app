# Utilisé UNIQUEMENT par scripts/migrate-to-supabase.ts — jamais lu par
# l'application elle-même. Copiez ce fichier en .env.migration (jamais
# commité) et renseignez vos vraies valeurs.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Identifiants de VOTRE compte administrateur (déjà créé et ajouté à la
# table admins). Le script s'en sert pour se connecter et écrire les
# données via les mêmes règles RLS que l'interface d'administration —
# jamais via la clé service_role.
MIGRATION_ADMIN_EMAIL=
MIGRATION_ADMIN_PASSWORD=
