# Copiez ce fichier en .env.local (jamais commité) et renseignez vos
# vraies valeurs, disponibles dans Supabase → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Uniquement nécessaire pour exécuter scripts/migrate-to-supabase.ts,
# jamais utilisée par l'application elle-même. Voir l'en-tête de ce script.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# MIGRATION_ADMIN_EMAIL=
# MIGRATION_ADMIN_PASSWORD=
# (ces deux dernières vont dans .env.migration, pas .env.local — voir le script)

# Analytics (facultatif — laissez vide pour ne rien activer)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
